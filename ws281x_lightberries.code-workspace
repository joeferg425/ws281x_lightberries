	"tasks": {
		"version": "2.0.0",
		"tasks": [
			{
				"label": "install editable",
				"type": "shell",
				"command": "pip",
				"args": [
					"install",
					"-e",
					"."
				],
				"problemMatcher": [],
				"group": {
					"kind": "build",
					"isDefault": true
				}
			},
			{
				"label": "coverage",
				"type": "shell",
				"command": "${command:python.interpreterPath}",
				"args": [
					"-m",
					"coverage",
					"run",
					"-m",
					"pytest"
				],
				"problemMatcher": []
			},
			{
				"label": "coverage run, report",
				"type": "shell",
				"command": "${command:python.interpreterPath}",
				"args": [
					"-m",
					"coverage",
					"html",
					"--omit",
					"./tests/*"
				],
				"problemMatcher": [],
				"dependsOn": [
					"coverage"
				],
			}
		]
	},
	"extensions": {
